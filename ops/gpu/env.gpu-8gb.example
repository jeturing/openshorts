# 8GB VRAM host: whisper/parakeet + Ollama time-share the GPU. cp to .env
TRANSCRIBE_BACKEND=parakeet
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8_float16
FFMPEG_ENCODER=auto
ASR_GPU_CONCURRENCY=1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_SCORE_BATCH=3
LLM_TIMEOUT=600
# GEMINI_API_KEY=   # recommended: layout picker + silent videos
